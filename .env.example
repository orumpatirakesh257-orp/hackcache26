# ==============================================================================
# SAHAI SETU (सहाय सेतु) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Client Application URL (For CORS and redirect links)
CLIENT_URL=http://localhost:3000

# Google Gemini API Key
# Optional: If omitted, the app will gracefully use realistic built-in rule engines & OCR parsers.
GEMINI_API_KEY=

# ElevenLabs Text-to-Speech API Key
# Optional: If omitted, the app automatically uses browser native Web Speech API synthesizer.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ABDM (Ayushman Bharat Digital Mission) Mock Mode
# Set to 'true' to use simulated ABDM records with instant OTP '123456'.
ABDM_MOCK_MODE=true

# Google Cloud Healthcare FHIR API Flag
# Set to 'true' to use local FHIR R4 schema compliance generator.
FHIR_MOCK_MODE=true
